{
  "name": "api-cuts",
  "version": "0.1.0",
  "description": "API for generating short-form video cuts",
  "type": "module",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "ffmpeg-static"
    ]
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "@fastify/sensible": "^5.6.0",
    "@google/generative-ai": "^0.24.1",
    "@types/ffmpeg-static": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "fastify-type-provider-zod": "^1.1.9",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "googleapis": "^171.4.0",
    "minio": "^8.0.0",
    "msedge-tts": "^2.0.4",
    "nanoid": "^5.0.7",
    "openai": "^6.34.0",
    "pino": "^8.21.0",
    "youtube-transcript": "^1.2.1",
    "yt-dlp-wrap": "^2.3.12",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^20.14.2",
    "drizzle-kit": "^0.21.4",
    "pino-pretty": "^11.2.1",
    "tsx": "^4.15.6",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
