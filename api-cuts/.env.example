NODE_ENV=development
PORT=3000

# SQLite — path inside the container (or local path for dev without Docker)
DATABASE_URL=./data/api-cuts.db

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cuts
MINIO_USE_SSL=false

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your-key-here
# Default model (swap freely — any OpenRouter model slug works)
# Good free-tier options:
#   google/gemini-2.0-flash-001   (Gemini 2.0 Flash — recommended)
#   google/gemini-2.0-flash-lite-001
#   meta-llama/llama-3.3-70b-instruct:free
#   mistralai/mistral-7b-instruct:free
OPENROUTER_MODEL=google/gemini-2.0-flash-001
